// 1. Kita daftarkan dulu semua pilihan Role yang valid sesuai database kamu
enum Role {
  Superadmin
  Finance
  HR
  GA
  Manager_Finance     @map("Manager Finance")     // Menangani spasi di DB
  Pelatihan
  Manager_pelatihan   @map("Manager pelatihan")   // Menangani spasi di DB
  Marketing
  manager_marketing   @map("manager marketing")   // Menangani spasi di DB
}

// 2. Kita buat skema tabel User-nya
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // Tempat menyimpan password terenkripsi
  role      Role     // Kolom role yang tipenya mengambil dari enum di atas
  createdAt DateTime @default(now())
}